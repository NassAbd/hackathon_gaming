{
  "name": "soniccheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:intent": "node scripts/eval-intent.mjs",
    "build:itch": "node scripts/build-itch.mjs",
    "build:api": "tsc --noEmit && vite build --config vite.api.config.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "build:vercel": "tsc --noEmit && node scripts/check-vercel-esm.mjs && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
